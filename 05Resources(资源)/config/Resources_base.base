properties:
  note.tags:
    displayName: tags
views:
  - type: table
    name: Resources
    filters:
      and:
        - file.folder.containsAny("05Resources(资源)")
        - '!file.name.endsWith("main")'
        - file.ext != "base"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - file.mtime
    sort:
      - property: file.basename
        direction: ASC
      - property: file.mtime
        direction: DESC
    cardSize: 250
